# Dependencies
node_modules/

# Build output
dist/
frontend/dist/
# Generated at build by scripts/copy-data.mjs (published copies of the snapshots)
frontend/public/data/

# macOS
.DS_Store

# Local env / secrets — never publish to a web-accessible repo
*.local

# Editor / logs
*.log

# Python caches (data scripts + tests)
__pycache__/
*.pyc

# Capacitor / iOS build artifacts
frontend/ios/App/Pods/
frontend/ios/App/App/public/
frontend/ios/DerivedData/

# SmPC raw-text download cache (regenerable)
frontend/scripts/smpc/.cache/

# USPI openFDA response cache (regenerable)
frontend/scripts/uspi/.cache/

# local Xcode build products
frontend/ios/App/build_sim/
frontend/ios/App/build_store/

# Xcode simulator build scratch dir
frontend/ios/App/build_sim_shot/
frontend/scripts/uspi/.cache2/

# Provenance of the last local EMA build (hashes of raw inputs) — regenerated by build-ema-data.py
frontend/scripts/.sources.json
